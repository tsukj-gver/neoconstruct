{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "default_agent": "pm",
  "agent": {
    "pm": {
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny",
          "construct/**": "deny",
          "docs/**": "deny",
          "construct-rs/**": "deny",
          "plans/**": "allow"
        },
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git add*": "ask",
          "git commit*": "ask",
          "git tag*": "ask",
          "git reset*": "deny",
          "git checkout*": "deny",
          "git rebase*": "deny",
          "git merge*": "deny",
          "git cherry-pick*": "deny",
          "rm *": "deny",
          "del *": "deny",
          "rmdir*": "deny"
        }
      }
    },
    "architect": {
      "mode": "subagent",
      "permission": {
        "edit": {
          "*": "deny",
          "construct/**": "deny",
          "construct-rs/**": "deny",
          "plans/**": "deny",
          "docs/**": "allow"
        },
        "bash": {
          "*": "deny"
        }
      }
    },
    "developer": {
      "mode": "subagent",
      "permission": {
        "edit": {
          "*": "deny",
          "construct/**": "deny",
          "docs/**": "deny",
          "plans/**/过程记录.md": "allow",
          "construct-rs/**": "allow"
        },
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git add*": "deny",
          "git commit*": "deny",
          "git tag*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny",
          "git rebase*": "deny",
          "git merge*": "deny",
          "git cherry-pick*": "deny",
          "rm *": "deny",
          "del *": "deny",
          "rmdir*": "deny"
        }
      }
    },
    "validator": {
      "mode": "subagent",
      "permission": {
        "edit": {
          "*": "deny",
          "construct/**": "deny",
          "docs/**": "deny",
          "construct-rs/**": "deny",
          "plans/**/过程记录.md": "allow"
        },
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git add*": "deny",
          "git commit*": "deny",
          "git tag*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny",
          "git rebase*": "deny",
          "git merge*": "deny",
          "git cherry-pick*": "deny",
          "rm *": "deny",
          "del *": "deny",
          "rmdir*": "deny"
        }
      }
    },
    "reviewer": {
      "mode": "subagent",
      "permission": {
        "edit": {
          "*": "deny",
          "construct/**": "deny",
          "docs/**": "deny",
          "construct-rs/**": "deny",
          "plans/**/过程记录.md": "allow"
        },
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git add*": "deny",
          "git commit*": "deny",
          "git tag*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny",
          "git rebase*": "deny",
          "git merge*": "deny",
          "git cherry-pick*": "deny",
          "rm *": "deny",
